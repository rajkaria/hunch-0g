# @hunch-0g/agent-runner — every env var the runner reads. Copy to .env and
# `set -a; . ./.env; set +a` (or use your process manager of choice).

# ── required for `tick` / `watch` (the betting agent) ────────────────────────
# The agent's EOA private key (0x + 64 hex). Sends bets (msg.sender = stake
# attribution), pays gas + storage fees, and signs level-1 attestations.
# NEVER printed or logged by the runner.
ZEROG_PRIVATE_KEY=

# The ArenaVault deployment to play. Required for all subcommands, including
# `verify` (it is the verifier's known-vault list).
ARENA_VAULT_ADDRESS=

# ── network ──────────────────────────────────────────────────────────────────
# mainnet = 0G Aristotle (16661, default) | galileo = 0G Galileo testnet (16601).
# Chain ids/RPCs come from @hunch-0g/pof's chain constants.
ZEROG_NETWORK=mainnet

# Optional RPC override (defaults to the network's public RPC).
ZEROG_RPC_URL=

# 0G Storage indexer for record upload/download.
ZEROG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai

# ── brain ────────────────────────────────────────────────────────────────────
# Path to a module whose DEFAULT export is a Brain (the BYO-brain contract —
# see src/brains/README.md). Unset = the built-in random calibration brain,
# which needs zero LLM keys.
BRAIN_MODULE=

# ── runner knobs ─────────────────────────────────────────────────────────────
# Per-market stake cap in wei, applied on top of the vault's maxBet. A brain's
# requested stake is clamped down to min(request, maxBet, this).
AGENT_MAX_STAKE_WEI=

# Comma-separated bytes32 market ids. When ALLOW is set, only those markets
# are played; DENY markets are never played.
AGENT_ALLOW_MARKETS=
AGENT_DENY_MARKETS=

# `watch` cadence in milliseconds (>= 1000). Coarse by design: markets move
# hourly, not per-block, and every tick costs RPC + storage reads.
AGENT_INTERVAL_MS=60000

# First block for the MarketCreated log scan (set to the vault's deploy block
# to keep discovery cheap).
AGENT_FROM_BLOCK=0
