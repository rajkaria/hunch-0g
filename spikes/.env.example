# Copy to spikes/.env and fill in. NEVER commit the filled copy.
#
# Every spike is read-only without `--send`, and each degrades gracefully when a
# key is missing — so a fresh clone with no .env at all still prints something
# real (chain head, provider list, a locally computed storage root).

# Which network the spikes target: mainnet (default) | galileo
ZEROG_NETWORK=mainnet

# Chain
ZEROG_RPC_URL=https://evmrpc.0g.ai
ZEROG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai

# Operator key — a NEW keypair, never the Base or Arbitrum relayer key.
# Needs a small native 0G balance for gas. Used by the chain spike (to broadcast
# a root-carrying transaction) and the storage spike (to pay the upload fee).
ZEROG_OPERATOR_PRIVATE_KEY=0x

# Compute — the wallet whose broker ledger holds prepaid inference credits.
# Top it up with broker.ledger.addLedger(amount) / depositFund(amount).
ZEROG_COMPUTE_PRIVATE_KEY=0x

# Optional: pin one inference provider by address. Unset means "first provider
# with an acknowledged TEE signer". Providers are discovered on-chain by the
# broker SDK, so there is no router URL to configure.
ZEROG_COMPUTE_PROVIDER=

# Storage
ZEROG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
