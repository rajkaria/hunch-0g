# Copy to spikes/.env and fill in. NEVER commit the filled copy.

# Which network the spikes target: mainnet (default) | galileo
# (spike:chain always deploys its hello contract to Galileo regardless;
#  this only switches the read/compute/storage RPC.)
ZEROG_NETWORK=mainnet

# Signing key used by ALL THREE spikes (chain deploy, compute ledger, storage
# upload). Use a NEW throwaway keypair with a small native 0G balance:
#  - Galileo 0G for the chain spike's deploy (faucet: https://faucet.0g.ai)
#  - mainnet 0G for storage fees + a funded compute ledger (min 3 0G to create)
# The spikes never print this value, only the derived address.
ZEROG_PRIVATE_KEY=0x

# RPC endpoints (defaults baked into src/zerog.ts)
ZEROG_RPC_URL=https://evmrpc.0g.ai
ZEROG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai

# Compute (spike:compute)
# Optional: pin a specific provider address instead of auto-picking the first
# verifiable (TeeML) service with an acknowledged TEE signer.
#ZEROG_COMPUTE_PROVIDER=0x
# Router base URL (declared in zerog.ts; not used by the broker SDK itself)
ZEROG_COMPUTE_ROUTER=https://router-api.0g.ai/v1

# Storage (spike:storage) — turbo indexer
ZEROG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
